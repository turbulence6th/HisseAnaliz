.entry-summary{
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    max-height: 87px;
}
.subcat-wrap>* {
    font-size: .8rem;
    display: inline-flex;
}

strong{
    font-weight: 700;
}

.entry-content p{
    line-height: 34px;
}

.advertise {
    display: block;
}
.advertise-mobile {
    display: none;
}

@media (max-width: 1260px) {
    .advertise {
        display: none;
    }
    .advertise-mobile {
        display: block;
    }
}
.sehir_select select{
    margin-left: 10px !important;
}
@media (max-width: 600px) {
    .wnav-holder-mobile a{
        margin-left: 20px;
    }
    .wnav-holder-mobile a span{
        font-size:12px !important;
    }
    .wnav-holder-mobile span{
        display: none !important;
    }
    .elementor-section{
        margin: 0px !important;
    }
}
