$('[data-title]').tipsy({
    arrowWidth: 10,
    attr: 'data-tipsy',
    cls: null,
    duration: 200,
    offset: 7,
    position: 'bottom-center',
    trigger: 'hover',
    onShow: null,
    onHide: null
})

$(document).ready(function() {
    $(".more-trigger").on("click", function(event) {
        $('.dropdown-activated').removeClass('dropdown-activated');
        event.stopPropagation();
        $(this).closest(".more-section-outer").toggleClass("dropdown-activated");
    });

    $(".dropdown-trigger, .search-trigger").on("click", function(event) {
        $('.dropdown-activated').removeClass('dropdown-activated');
        event.stopPropagation();
        $(this).closest(".header-dropdown-outer").toggleClass("dropdown-activated");
    });

    $(document).on("click", function() {
        $(".more-section-outer, .header-dropdown-outer").removeClass("dropdown-activated");
    });

    $(".more-section-outer, .header-dropdown-outer").on("click", function(event) {
        event.stopPropagation();
    });

    const swiper1 = new Swiper('.post-carousel', {
        direction: 'horizontal',
        loop: true,
        slidesPerView: 1,
        pagination: {
            el: ".slider-pagination",
            clickable: true,
        },
        navigation: {
            nextEl: '.slider-next',
            prevEl: '.slider-prev',
        },
        breakpoints: {
            768: {
                slidesPerView: 2,
                spaceBetween: 0,
            },
            1024: {
                slidesPerView: 4,
                spaceBetween: 0,
            },
        },
    });

    const swiper2 = new Swiper('.breaking-news-slider', {
        direction: 'horizontal',
        loop: true,
        autoplay: {
            delay: 4000,
        },
        navigation: {
            nextEl: '.breaking-news-next'
        },
    });

    $(".mobile-menu-trigger").on("click", function(event) {
        $('body').toggleClass('collapse-activated');
        $('html').toggleClass('no-scroll');
        event.stopPropagation();
    });

    $(".share-action").on("click", function(event) {
        event.preventDefault();
        var url = $(this).attr("href");
        window.open(url, "_blank", "width=600,height=400,top=100,left=100");
    });

    $(".copy-trigger").on("click", function(event) {
        event.preventDefault();
        var linkURL = $(this).attr("data-link");

        var tempInput = $("<input>");
        $("body").append(tempInput);
        tempInput.val(linkURL).select();
        document.execCommand("copy");
        tempInput.remove();

        $(this).attr("data-title", "Bağlantı kopyalandı!");
        $(this).tipsy("hide").tipsy("show");
    });

    let lastScrollTop = 0;
    let header = $("#sticky-holder");

    $(window).on("scroll", function() {
        let scrollTop = $(this).scrollTop();

        if(scrollTop < 110){
            header.removeClass('sticky-on');
        }

        if (scrollTop < lastScrollTop && scrollTop > 200) {
            header.addClass('sticky-on')
        }

        lastScrollTop = scrollTop;
    });


    $(window).on("scroll", function () {
        var scrollTop = $(window).scrollTop() + 600; // Kullanıcının ne kadar aşağı kaydırdığı
        var docHeight = $(document).height(); // Dokümanın toplam yüksekliği
        var winHeight = $(window).height(); // Pencere yüksekliği

        var scrollPercent = (scrollTop / (docHeight - winHeight)) * 100;
        $("#reading-progress").css("width", scrollPercent + "%");
    });

    $(".show-post-comment").on("click", function(event) {
        event.preventDefault();
        $(this).hide();
        $(this).parents('.comment-box-wrap').find('.comment-holder').removeClass('is-hidden').show();
    });
}) ;