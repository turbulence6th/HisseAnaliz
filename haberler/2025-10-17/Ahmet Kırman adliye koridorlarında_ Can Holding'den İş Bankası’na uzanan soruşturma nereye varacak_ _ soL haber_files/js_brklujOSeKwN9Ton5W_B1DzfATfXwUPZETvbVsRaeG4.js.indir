(function(Drupal,once){"use strict";function getPageUrl(btn){if(btn&&btn.dataset&&btn.dataset.copyUrl)return btn.dataset.copyUrl;if(btn&&btn.dataset&&btn.dataset.copy==="canonical"){var c=document.querySelector('link[rel="canonical"]');if(c&&c.href)return c.href;}return window.location.href;}function copyWithFallback(text){try{var ta=document.createElement("textarea");ta.value=text;ta.setAttribute("readonly","");ta.style.position="absolute";ta.style.left="-9999px";document.body.appendChild(ta);ta.select();var ok=document.execCommand("copy");document.body.removeChild(ta);return ok?Promise.resolve():Promise.reject();}catch(e){return Promise.reject(e);}}function copyToClipboard(text){if(navigator.clipboard&&navigator.clipboard.writeText)return navigator.clipboard.writeText(text);return copyWithFallback(text);}function showMsg(btn,ok){var msgEl=null,p=btn.parentElement;while(p&&!msgEl){msgEl=p.querySelector(".copy-msg");p=p.parentElement;}if(!msgEl)msgEl=document.querySelector(".copy-msg");if(!msgEl)return;var copied=btn.dataset.copiedLabel?Drupal.t(btn.dataset.copiedLabel):Drupal.t("Kopyalandı");var failed=btn.dataset.copyErrorLabel?Drupal.t(btn.dataset.copyErrorLabel):Drupal.t("Kopyalanamadı");var text=ok?copied:failed;msgEl.textContent=text;msgEl.classList.remove("d-none");msgEl.classList.toggle("is-copy-error",!ok);window.clearTimeout(msgEl._t);msgEl._t=window.setTimeout(function(){msgEl.classList.add("d-none");msgEl.classList.remove("is-copy-error");},1600);}Drupal.behaviors.copyPageUrl={attach:function(context){once("copyPageUrl",".btn-copy",context).forEach(function(btn){btn.addEventListener("click",function(e){e.preventDefault();var url=getPageUrl(btn);copyToClipboard(url).then(function(){showMsg(btn,true);}).catch(function(){showMsg(btn,false);});});});}};})(Drupal,once);;
