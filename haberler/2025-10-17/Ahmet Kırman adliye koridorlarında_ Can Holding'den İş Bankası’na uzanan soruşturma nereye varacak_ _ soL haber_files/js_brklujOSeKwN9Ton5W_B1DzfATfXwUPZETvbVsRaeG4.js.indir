(function($,Drupal){"use strict";function hasClass(el,cls){return el&&el.className&&(' '+el.className+' ').indexOf(' '+cls+' ')>-1;}function addClass(el,cls){if(!el)return;if(!hasClass(el,cls))el.setAttribute('class',(el.className?el.className+' ':'')+cls);}function removeClass(el,cls){if(!el||!el.className)return;el.setAttribute('class',el.className.replace(new RegExp('\\b'+cls+'\\b','g'),'').replace(/\s{2,}/g,' ').trim());}function removeColumnClasses(el){if(!el||!el.className)return;var cleaned=el.className.replace(/\bcolumn-\d+\b/g,'').replace(/\s{2,}/g,' ').trim();el.setAttribute('class',cleaned);}Drupal.behaviors.koseYazilari={attach:function(context){once('koseYazilari-init','.kose-yazilari',context).forEach(function(root){var sliderEl=root.querySelector('.kose-yazilari-slider');if(!sliderEl)return;var listEl=sliderEl.querySelector('.splide__list')||sliderEl;var children=listEl.children;var count=0;for(var i=0;i<children.length;i++){var ch=children[i];if(ch.nodeType!==1)continue;var cn=ch.className||'';var isSlide=cn.indexOf('splide__slide')>-1&&cn.indexOf('is-clone')===-1;var isItem=cn.indexOf('item')>-1;if(isSlide||isItem)count++;}if(count===0)return;removeColumnClasses(listEl);if(count>0&&count<=4)addClass(listEl,'column-'+count);var splide=new Splide(sliderEl,{perPage:4,pagination:false,speed:1000,arrows:false,gap:'32px',breakpoints:{992:{perPage:2,gap:'24px'},1310:{perPage:3,gap:'24px'},1400:{perPage:4}}});var arrowWrap=root.querySelector('.kose-yazilari .slider-btns');var prevBtn=root.querySelector('.splide_prev');var nextBtn=root.querySelector('.splide_next');if(!arrowWrap||!prevBtn||!nextBtn){splide.mount();return;}function toggleArrowsByCount(){var w=window.innerWidth||document.documentElement.clientWidth||0;var shouldShow=(w<=1200)||(w>1200&&count>4);if(shouldShow)removeClass(arrowWrap,'d-none');else addClass(arrowWrap,'d-none');}function updateDisabled(){var endIndex=splide.Components.Controller.getEnd();var i=splide.index;if(i===0)addClass(prevBtn