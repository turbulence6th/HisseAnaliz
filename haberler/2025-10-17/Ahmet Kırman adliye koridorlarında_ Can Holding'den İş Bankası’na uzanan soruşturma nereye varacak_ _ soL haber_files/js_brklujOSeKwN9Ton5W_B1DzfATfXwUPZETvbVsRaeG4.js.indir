(function(Drupal,drupalSettings,once){'use strict';function getCookie(name){const m=document.cookie.match(new RegExp('(?:^|; )'+name.replace(/([.$?*|{}()[\]\\/+^])/g,'\\$1')+'=([^;]*)'));return m?decodeURIComponent(m[1]):null;}function setCookie(name,value,days){const d=new Date();d.setTime(d.getTime()+days*24*60*60*1000);document.cookie=name+'='+encodeURIComponent(value)+'; path=/; expires='+d.toUTCString();}function getPeriodKey(){const now=new Date();const y=now.getFullYear();const m=String(now.getMonth()+1).padStart(2,'0');return `${y}-${m}`;}function daysUntilEndOfMonth(){const now=new Date();const nextMonthStart=new Date(now.getFullYear(),now.getMonth()+1,1);const diffMs=nextMonthStart-now;return Math.max(1,Math.ceil(diffMs/(24*60*60*1000)));}function getArticleId(){const el=document.querySelector('.article--haber[data-history-node-id]');const id=el&&el.getAttribute('data-history-node-id');return id?String(id):null;}function readSeen(name){const v=getCookie(name);if(!v)return [];return v.split(',').map((s)=>s.trim()).filter(Boolean);}function writeSeen(name,ids,ttlDays){setCookie(name,ids.join(','),ttlDays);}function renderDynamicText(count,cfg){const tpl=(cfg.dynamicText||'').replace(/\{count\}/g,String(count));const html=tpl.replace(/\n/g,'<br>');document.querySelectorAll('[data-dynamic-text]').forEach((el)=>{el.innerHTML=html;});}function updateVisibility(reads,minValue,cfg){const show=reads>=minValue;document.querySelectorAll('[data-dynamic-block]').forEach(function(el){el.hidden=!show;el.classList.toggle('dyn-hidden',!show);el.classList.toggle('dyn-visible',show);});if(show)renderDynamicText(reads,cfg);}Drupal.behaviors.solDynamicCounterAndReader={attach:function(context){once('solDynamicCounterAndReader','html',context).forEach(function(){const cfg=(drupalSettings.sol_adverts&&drupalSettings.sol_adverts.dynamic)||{};const periodKey=getPeriodKey();const readsBase=cfg.cookieName||'sol_reads';const seenBase=cfg.seenCookie||'sol_reads_seen';const readsName=`